{
  "manifest_version": 3,
  "name": "GastaBot AGS – Compras con presupuesto",
  "version": "2.6.0",
  "description": "Dime tu presupuesto y qué se te antoja; te armo un combo de compras en las plazas de tu ciudad.",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://places.googleapis.com/*",
    "https://*.supabase.co/*",
    "https://overpass-api.de/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "Abrir GastaBot",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}